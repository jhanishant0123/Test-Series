08:46:14 out   const CATEGORY_RULES = [
08:46:14 out   ["mock", /\bmock\b/],
08:46:14 out   ["subjectwise", /subject[\s_-]*wise/],
08:46:14 out   ["topicwise", /topic[\s_-]*wise/],
08:46:14 out   ["aptitude", /\baptitude\b/],
08:46:14 out   ["advance", /\badvance/],
08:46:14 out   ["basic", /\bbasic\b/],
08:46:14 out   ["demo", /\bdemo\b/],
08:46:14 out   ["full-syllabus", /full[\s_-]*syllabus/],
08:46:14 out   ["part-syllabus", /part[\s_-]*syllabus/]
08:46:14 out   ];
08:46:14 out   const CATEGORY_LABELS = {
08:46:14 out   all: "All types",
08:46:14 out   mock: "Mock",
08:46:14 out   "practice-mock": "Practice mock",
08:46:14 out   subjectwise: "Subjectwise",
08:46:14 out   "practice-subjectwise": "Practice subjectwise",
08:46:14 out   "multi-subjectwise": "Multi-subject",
08:46:14 out   topicwise: "Topicwise",
08:46:14 out   "practice-topicwise": "Practice topicwise",
08:46:14 out   aptitude: "Aptitude",
08:46:14 out   advance: "Advance",
08:46:14 out   basic: "Basic",
08:46:14 out   demo: "Demo",
08:46:14 out   "full-syllabus": "Full syllabus",
08:46:14 out   "part-syllabus": "Part syllabus",
08:46:14 out   other: "Other"
08:46:14 out   };
08:46:14 out   const CATEGORY_ORDER = [
08:46:14 out   "all", "mock", "practice-mock", "subjectwise", "practice-subjectwise",
08:46:14 out   "multi-subjectwise", "topicwise", "practice-topicwise", "aptitude",
08:46:14 out   "advance", "basic", "full-syllabus", "part-syllabus", "demo", "other"
08:46:14 out   ];
08:46:14 out   const PROVIDER_ALIASES = {
08:46:14 out   "MADE EASY": "BIJZLI EASY",
08:46:14 out   "GATE ZEAL": "BIJZLI ZEAL"
08:46:14 out   };
08:46:14 out   const numberFormat = new Intl.NumberFormat("en-IN");
08:46:14 out   function tidy(text) {
08:46:14 out   return String(text ?? "")
08:46:14 out   .replace(/_/g, " ")
08:46:14 out   .replace(/\s*-\s*-\s*/g, " - ")
08:46:14 out   .replace(/\s+/g, " ")
08:46:14 out   .trim();
08:46:14 out   }
08:46:14 out   function slugify(text) {
08:46:14 out   const base = tidy(text)
08:46:14 out   .toLowerCase()
08:46:14 out   .replace(/[^a-z0-9]+/g, "-")
08:46:14 out   .replace(/^-+|-+$/g, "");
08:46:14 out   if (!base) return "item";
08:46:14 out   if (base.length <= 60) return base;
08:46:14 out   const cut = base.slice(0, 60);
08:46:14 out   const boundary = cut.lastIndexOf("-");
08:46:14 out   return (boundary > 24 ? cut.slice(0, boundary) : cut).replace(/-+$/, "") || "item";
08:46:14 out   }
08:46:14 out   function activityKey(path) {
08:46:14 out   return String(path ?? "").toLowerCase().replace(/\.html?$/, "");
08:46:14 out   }
08:46:14 out   function providerLabel(name) {
08:46:14 out   const clean = tidy(name);
08:46:14 out   return PROVIDER_ALIASES[clean.toUpperCase()] ?? clean;
08:46:14 out   }
08:46:14 out   function branchMeta(name) {
08:46:14 out   const upper = String(name ?? "").toUpperCase();
08:46:14 out   return BRANCH_META.find((entry) => upper.includes(entry.match)) || { code: upper.slice(0, 2) || "GA", hue: 210 };
08:46:14 out   }
08:46:14 out   function accentFor(hue) {
08:46:14 out   return `hsl(${hue} 72% 58%)`;
08:46:14 out   }
08:46:14 out   function categoryOf(title) {
08:46:14 out   const text = title.toLowerCase();
08:46:14 out   const hit = CATEGORY_RULES.find(([, pattern]) => pattern.test(text));
08:46:14 out   return hit ? hit[0] : "other";
08:46:14 out   }
08:46:14 out   function yearsIn(text) {
08:46:14 out   return Array.from(new Set(String(text).match(/(?<![0-9])20\d{2}(?![0-9])/g) || []));
08:46:14 out   }
08:46:14 out   function paperNumber(fileName) {
08:46:14 out   const name = String(fileName ?? "");
08:46:14 out   const match = /^(\d{1,4})[_\-\s]/.exec(name);
08:46:14 out   if (match) return match[1].replace(/^0+(?=\d)/, "");
08:46:14 out   const idMatch = /test[\s_-]*id[\s_-]*-?[\s_-]*(\d+)/i.exec(name);
08:46:14 out   return idMatch ? idMatch[1] : "";
08:46:14 out   }
08:46:14 out   function pluralize(count, singular, plural = `${singular}s`) {
08:46:14 out   return `${numberFormat.format(count)} ${count === 1 ? singular : plural}`;
08:46:14 out   }
08:46:14 out   function el(tag, className, text) {
08:46:14 out   const node = document.createElement(tag);
08:46:14 out   if (className) node.className = className;
08:46:14 out   if (text != null) node.textContent = text;
08:46:14 out   return node;
08:46:14 out   }
08:46:14 out   function icon(paths, className) {
08:46:14 out   const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
08:46:14 out   svg.setAttribute("viewBox", "0 0 24 24");
08:46:14 out   svg.setAttribute("aria-hidden", "true");
08:46:14 out   if (className) svg.setAttribute("class", className);
08:46:14 out   paths.forEach((d) => {
08:46:14 out   const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
08:46:14 out   path.setAttribute("d", d);
08:46:14 out   svg.appendChild(path);
08:46:14 out   });
08:46:14 out   return svg;
08:46:14 out   }
08:46:14 out   function relativeTime(timestamp) {
08:46:14 out   if (!timestamp) return "";
08:46:14 out   const minutes = Math.round((Date.now() - timestamp) / 60000);
08:46:14 out   if (minutes < 1) return "just now";
08:46:14 out   if (minutes < 60) return `${minutes}m ago`;
08:46:14 out   const hours = Math.round(minutes / 60);
08:46:14 out   if (hours < 24) return `${hours}h ago`;
08:46:14 out   const days = Math.round(hours / 24);
08:46:14 out   if (days === 1) return "yesterday";
08:46:14 out   if (days < 7) return `${days}d ago`;
08:46:14 out   return new Date(timestamp).toLocaleDateString("en-IN", { day: "numeric", month: "short" });
08:46:14 out   }
08:46:14 out   /* Storage */
08:46:14 out   function readStore(key, fallback) {
08:46:14 out   try {
08:46:14 out   const raw = localStorage.getItem(key);
08:46:14 out   if (!raw) return fallback;
08:46:14 out   const parsed = JSON.parse(raw);
08:46:14 out   return parsed && typeof parsed === "object" ? parsed : fallback;
08:46:14 out   } catch (_error) {
08:46:14 out   return fallback;
08:46:14 out   }
08:46:14 out   }
08:46:14 out   function writeStore(key, value) {
08:46:14 out   try {
08:46:14 out   localStorage.setItem(key, JSON.stringify(value));
08:46:14 out   } catch (_error) {
08:46:14 out   /* storage is optional */
08:46:14 out   }
08:46:14 out   }
08:46:14 out   function loadLocalState() {
08:46:14 out   state.activity = readStore(ACTIVITY_KEY, {});
08:46:14 out   const savedList = readStore(SAVED_KEY, []);
08:46:14 out   state.saved = new Set(Array.isArray(savedList) ? savedList : []);
08:46:14 out   }
08:46:14 out   function recordOpen(paper) {
08:46:14 out   const store = readStore(ACTIVITY_KEY, {});
08:46:14 out   const previous = store[paper.key] || {};
08:46:14 out   store[paper.key] = {
08:46:14 out   ...previous,
08:46:14 out   title: paper.title,
08:46:14 out   branch: paper.branchName,
08:46:14 out   series: paper.seriesLabel,
08:46:14 out   openedAt: Date.now(),
08:46:14 out   opens: (previous.opens || 0) + 1
08:46:14 out   };
08:46:14 out   writeStore(ACTIVITY_KEY, store);
08:46:14 out   state.activity = store;
08:46:14 out   }
08:46:14 out   function toggleSaved(path) {
08:46:14 out   if (state.saved.has(path)) state.saved.delete(path);
08:46:14 out   else state.saved.add(path);
08:46:14 out   writeStore(SAVED_KEY, Array.from(state.saved));
08:46:14 out   }
08:46:14 out   function entryFor(path) {
08:46:14 out   return state.activity[path] || null;
08:46:14 out   }
08:46:14 out   function scoreOf(entry) {
08:46:14 out   if (!entry || entry.submittedAt == null) return null;
08:46:14 out   const marks = Number(entry.marks);
08:46:14 out   const total = Number(entry.total);
08:46:14 out   if (Number.isFinite(marks) && Number.isFinite(total) && total > 0) {
08:46:14 out   return { basis: "marks", value: marks, max: total, pct: Math.max(0, (marks / total) * 100) };
08:46:14 out   }
08:46:14 out   const correct = Number(entry.correct);
08:46:14 out   const questions = Number(entry.questions);
08:46:14 out   if (Number.isFinite(correct) && Number.isFinite(questions) && questions > 0) {
08:46:14 out   return { basis: "questions", value: correct, max: questions, pct: Math.max(0, (correct / questions) * 100) };
08:46:14 out   }
08:46:14 out   return null;
08:46:14 out   }
08:46:14 out   /* Index */
08:46:14 out   function unique(slug, used) {
08:46:14 out   let candidate = slug;
08:46:14 out   let counter = 2;
08:46:14 out   while (used.has(candidate)) candidate = `${slug}-${counter++}`;
08:46:14 out   used.add(candidate);
08:46:14 out   return candidate;
08:46:14 out   }
08:46:14 out   function buildIndex(manifest) {
08:46:14 out   const branches = [];
08:46:14 out   const papers = [];
08:46:14 out   const byKey = new Map();
08:46:14 out   const usedBranchSlugs = new Set();
08:46:14 out   manifest.branches.forEach((rawBranch) => {
08:46:14 out   const meta = branchMeta(rawBranch.name);
08:46:14 out   const branch = {
08:46:14 out   name: tidy(rawBranch.name),
08:46:14 out   slug: unique(slugify(rawBranch.name), usedBranchSlugs),
08:46:14 out   code: meta.code,
08:46:14 out   accent: accentFor(meta.hue),
08:46:14 out   testCount: rawBranch.testCount || 0,
08:46:14 out   providers: []
08:46:14 out   };
08:46:14 out   const usedProviderSlugs = new Set();
08:46:14 out   (rawBranch.providers || []).forEach((rawProvider) => {
08:46:14 out   const provider = {
08:46:14 out   name: providerLabel(rawProvider.name),
08:46:14 out   slug: unique(slugify(providerLabel(rawProvider.name)), usedProviderSlugs),
08:46:14 out   testCount: rawProvider.testCount || 0,
08:46:14 out   branch,
08:46:14 out   series: []
08:46:14 out   };
08:46:14 out   const usedSeriesSlugs = new Set();
08:46:14 out   (rawProvider.series || []).forEach((rawSeries) => {
08:46:14 out   const label = tidy(rawSeries.name);
08:46:14 out   const labelYears = yearsIn(rawSeries.name);
08:46:14 out   const seriesYears = (labelYears.length ? labelYears : yearsIn(rawSeries.path)).sort();
08:46:14 out   const series = {
08:46:14 out   name: label,
08:46:14 out   slug: unique(slugify(label), usedSeriesSlugs),
08:46:14 out   path: rawSeries.path,
08:46:14 out   yearLabel: seriesYears.length >= 2
08:46:14 out   ? `${seriesYears[0]}-${seriesYears[seriesYears.length - 1]}`
08:46:14 out   : seriesYears[0] || "Batch",
08:46:14 out   testCount: rawSeries.testCount || 0,
08:46:14 out   branch,
08:46:14 out   provider,
08:46:14 out   tests: []
08:46:14 out   };
08:46:14 out   (rawSeries.tests || []).forEach((rawTest, index) => {
08:46:14 out   const title = tidy(rawTest.title);
08:46:14 out   const years = yearsIn(title);
08:46:14 out   const paper = {
08:46:14 out   path: rawTest.path,
08:46:14 out   key: activityKey(rawTest.path),
08:46:14 out   href: `${PAPER_BASE}${encodeURI(rawTest.path)}`,
08:46:14 out   title,
