08:46:14 out   /* Search */
08:46:14 out   function searchPapers(query) {
08:46:14 out   const tokens = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
08:46:14 out   if (!tokens.length) return { tokens, results: [] };
08:46:14 out   const results = [];
08:46:14 out   state.papers.forEach((paper) => {
08:46:14 out   if (!tokens.every((token) => paper.haystack.includes(token))) return;
08:46:14 out   const title = paper.title.toLowerCase();
08:46:14 out   let score = 0;
08:46:14 out   tokens.forEach((token) => {
08:46:14 out   const index = title.indexOf(token);
08:46:14 out   if (index === 0) score += 60;
08:46:14 out   else if (index > 0) score += 30 - Math.min(index, 20);
08:46:14 out   if (new RegExp(`\\b${token.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}`).test(title)) score += 15;
08:46:14 out   });
08:46:14 out   score -= Math.min(paper.title.length / 12, 8);
08:46:14 out   if (entryFor(paper.key)) score += 5;
08:46:14 out   results.push({ paper, score });
08:46:14 out   });
08:46:14 out   results.sort((a, b) => b.score - a.score || a.paper.title.localeCompare(b.paper.title));
08:46:14 out   return { tokens, results: results.map((item) => item.paper) };
08:46:14 out   }
08:46:14 out   function renderSearch(query) {
