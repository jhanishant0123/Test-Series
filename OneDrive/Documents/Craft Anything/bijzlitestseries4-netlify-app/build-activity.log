08:46:14 out   function highlight(text, tokens) {
08:46:14 out   const fragment = document.createDocumentFragment();
08:46:14 out   if (!tokens.length) {
08:46:14 out   fragment.appendChild(document.createTextNode(text));
08:46:14 out   return fragment;
08:46:14 out   }
08:46:14 out   const pattern = new RegExp(
08:46:14 out   `(${tokens.map((token) => token.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})`,
08:46:14 out   "gi"
08:46:14 out   );
08:46:14 out   let lastIndex = 0;
08:46:14 out   let match;
08:46:14 out   while ((match = pattern.exec(text)) !== null) {
08:46:14 out   if (match.index > lastIndex) {
08:46:14 out   fragment.appendChild(document.createTextNode(text.slice(lastIndex, match.index)));
08:46:14 out   }
08:46:14 out   fragment.appendChild(el("mark", "mark", match[0]));
08:46:14 out   lastIndex = match.index + match[0].length;
08:46:14 out   if (match[0].length === 0) pattern.lastIndex += 1;
08:46:14 out   }
08:46:14 out   if (lastIndex < text.length) {
08:46:14 out   fragment.appendChild(document.createTextNode(text.slice(lastIndex)));
08:46:14 out   }
08:46:14 out   return fragment;
08:46:14 out   }
