08:40:20 out   o._topRects=[...card.querySelector(".test-top").children].map(e=>{const b=e.getBoundingClientRect();return [e.className,Math.round(b.x*10)/10,Math.round(b.y*10)/10,Math.round(b.width*10)/10,Math.round(b.height*10)/10];});
